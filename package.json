{
  "name": "@dracor/react",
  "version": "1.8.0",
  "description": "DraCor react component library",
  "repository": "https://github.com/dracor-org/dracor-react",
  "homepage": "https://github.com/dracor-org/dracor-react#readme",
  "author": "Carsten Milling <cmil@hashtable.de>",
  "license": "MIT",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/dracor.css",
    "src/tei.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ApiDoc": {
      "types": "./dist/components/ApiDoc/index.d.ts",
      "import": "./dist/components/ApiDoc/index.js"
    },
    "./AuthorInfo": {
      "types": "./dist/components/AuthorInfo/index.d.ts",
      "import": "./dist/components/AuthorInfo/index.js"
    },
    "./Authors": {
      "types": "./dist/components/Authors/index.d.ts",
      "import": "./dist/components/Authors/index.js"
    },
    "./Commit": {
      "types": "./dist/components/Commit/index.d.ts",
      "import": "./dist/components/Commit/index.js"
    },
    "./CorpusCard": {
      "types": "./dist/components/CorpusCard/index.d.ts",
      "import": "./dist/components/CorpusCard/index.js"
    },
    "./DebouncedInput": {
      "types": "./dist/components/DebouncedInput/index.d.ts",
      "import": "./dist/components/DebouncedInput/index.js"
    },
    "./DocPage": {
      "types": "./dist/components/DocPage/index.d.ts",
      "import": "./dist/components/DocPage/index.js"
    },
    "./DownloadButton": {
      "types": "./dist/components/DownloadButton/index.d.ts",
      "import": "./dist/components/DownloadButton/index.js"
    },
    "./DracorCorpusCard": {
      "types": "./dist/components/DracorCorpusCard/index.d.ts",
      "import": "./dist/components/DracorCorpusCard/index.js"
    },
    "./IdCopy": {
      "types": "./dist/components/IdCopy/index.d.ts",
      "import": "./dist/components/IdCopy/index.js"
    },
    "./IdLink": {
      "types": "./dist/components/IdLink/index.d.ts",
      "import": "./dist/components/IdLink/index.js"
    },
    "./LanguageMenu": {
      "types": "./dist/components/LanguageMenu/index.d.ts",
      "import": "./dist/components/LanguageMenu/index.js"
    },
    "./NavBar": {
      "types": "./dist/components/Navigation/index.d.ts",
      "import": "./dist/components/Navigation/index.js"
    },
    "./Table": {
      "types": "./dist/components/Table/index.d.ts",
      "import": "./dist/components/Table/index.js"
    },
    "./Tabs": {
      "types": "./dist/components/Tabs/index.d.ts",
      "import": "./dist/components/Tabs/index.js"
    },
    "./TEIText": {
      "types": "./dist/components/TEIText/index.d.ts",
      "import": "./dist/components/TEIText/index.js"
    },
    "./Years": {
      "types": "./dist/components/Years/index.d.ts",
      "import": "./dist/components/Years/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./dracor.css": {
      "default": "./src/dracor.css"
    },
    "./tei.css": {
      "default": "./src/tei.css"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate-icon-components": "svgr --typescript --jsx-runtime automatic --ignore-existing --out-dir src/components/icons src/icons",
    "release": "./prepublish.sh && pnpm publish --access public"
  },
  "dependencies": {},
  "devDependencies": {
    "@chromatic-com/storybook": "^5.4.0",
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@headlessui/react": "^2.2.10",
    "@scalar/api-reference-react": "^0.9.76",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/builder-vite": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@svgr/cli": "^8.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "CETEIcean": "^1.9.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "pathe": "^2.0.3",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "unified": "^11.0.5",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.2.0",
    "@headlessui/react": "^2.2.9",
    "@scalar/api-reference-react": "0.9.65",
    "@tanstack/react-router": "^1.166.2",
    "@tanstack/react-table": "^8.21.3",
    "CETEIcean": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "peerDependenciesMeta": {
    "@fortawesome/fontawesome-svg-core": { "optional": true },
    "@fortawesome/free-brands-svg-icons": { "optional": true },
    "@fortawesome/free-solid-svg-icons": { "optional": true },
    "@fortawesome/react-fontawesome": { "optional": true },
    "@headlessui/react": { "optional": true },
    "@scalar/api-reference-react": { "optional": true },
    "@tanstack/react-router": { "optional": true },
    "@tanstack/react-table": { "optional": true },
    "CETEIcean": { "optional": true },
    "react-markdown": { "optional": true }
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "packageManager": "pnpm@12.8.1"
}
